# This build has an intentionally tiny allowlist. Ignored local credentials and
# multi-gigabyte Rust build trees must never enter the Docker daemon's context.
**
!pyproject.toml
!uv.lock
!README.md
!LICENSE
!src/
!src/**
!deploy/
!deploy/macos-validator/
!deploy/macos-validator/Caddy.Dockerfile
!deploy/macos-validator/Dockerfile
!deploy/macos-validator/container-entrypoint.sh
!deploy/linux-validator-supervisor-worker/
!deploy/linux-validator-supervisor-worker/Dockerfile
!deploy/linux-competition-worker/
!deploy/linux-competition-worker/Dockerfile
!rust/
!rust/grandpa-finality-observer/
!rust/grandpa-finality-observer/Cargo.toml
!rust/grandpa-finality-observer/Cargo.lock
!rust/grandpa-finality-observer/build.rs
!rust/grandpa-finality-observer/rust-toolchain.toml
!rust/grandpa-finality-observer/src/
!rust/grandpa-finality-observer/src/**
!rust/grandpa-finality-observer/fixtures/
!rust/grandpa-finality-observer/fixtures/**
!rust/grandpa-finality-observer/vendor/
!rust/grandpa-finality-observer/vendor/**
!rust/substrate-proof-verifier/
!rust/substrate-proof-verifier/Cargo.toml
!rust/substrate-proof-verifier/Cargo.lock
!rust/substrate-proof-verifier/src/
!rust/substrate-proof-verifier/src/**
!rust/substrate-proof-verifier/fixtures/
!rust/substrate-proof-verifier/fixtures/**
!rust/runtime-metadata/
!rust/runtime-metadata/Cargo.toml
!rust/runtime-metadata/Cargo.lock
!rust/runtime-metadata/src/
!rust/runtime-metadata/src/**

# Defense in depth for ignored files accidentally placed below an allowed path.
**/.env
**/.env.*
**/.envrc
**/.bittensor/
**/wallets/
**/*.jks
**/*.keystore
**/*.p12
**/*.pem
**/*.pfx
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
**/*.egg-info/
**/.mypy_cache/
**/.pytest_cache/
**/build/
**/target/
