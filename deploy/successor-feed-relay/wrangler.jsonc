{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "umi-successor-feed-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-16",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "logpush": false,
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false },
    "traces": { "enabled": false },
  },
  "r2_buckets": [{ "binding": "FEED", "bucket_name": "umi-public-evidence" }],
  "vars": {
    "ENABLED": "true",
    "SOURCE_ORIGIN": "https://successor-source.umi.vision",
    "DESTINATION_ORIGIN": "https://pub-bfe43425f6564cc98cb3ad43b9662ae3.r2.dev",
    "CHANNEL_ID": "a3ca19a108fe7d1a8e53a2db76f480ebe237b7942595f23135d6e11889ed40c0",
    "PLATFORM": "linux-amd64",
    "INITIAL_CURSOR": "4/459/bdf306b7999f4473ce6fa0983eefe8341c6feaaec6b9e23dd1c8231927c61590",
  },
  "triggers": { "crons": ["* * * * *"] },
}
