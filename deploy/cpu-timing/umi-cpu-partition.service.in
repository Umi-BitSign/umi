[Unit]
Description=Restore prospective UMI CPU slot partition
Requires=umiexecution.slice
After=umiexecution.slice
Before=umi-c5-primary-reviewer-uid54.service umi-c5-optional-reviewer-uid0.service
RefuseManualStop=yes

[Service]
Type=oneshot
RemainAfterExit=yes
Slice=umiexecution.slice
Delegate=cpu cpuset memory io pids
DelegateSubgroup=setup
AllowedCPUs=@ALL_CPUS@
AllowedMemoryNodes=@NUMA_NODES@
# Do not set a small MemoryMax on this service: its descendants are the models.
# The restorer limits its own setup leaf, independently of descendant envelopes.
ExecStart=@SIGNED_PYTHON@ -I -B -m umi.host_cpu_partition --config @ROOT_OWNED_PLAN@
TimeoutStartSec=30
KillMode=process
UMask=0077

[Install]
WantedBy=multi-user.target
