[Unit]
Description=UMI native cohort settlement or independent review (%i)
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=@SERVICE_USER@
Group=@SERVICE_GROUP@
UMask=0077
ExecStart=@PYTHON@ -I -B -m umi.competition_cohort_settlement_cli run --config @CONFIG_DIRECTORY@/%i.json
Restart=on-failure
RestartSec=15
TimeoutStopSec=infinity
KillSignal=SIGTERM
# Signal the owner first so it can finish its current proof and drain children.
KillMode=mixed
SendSIGKILL=no
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
# Expand to explicit account-private shared byte roots; empty for older omitted selections.
# Preserved import roots remain read-only under ProtectSystem=strict.
ReadWritePaths=@STATE_ROOT@ @CHAIN_STATE@ @EXECUTION_ROOTS@ @PROMOTION_ROOT@ @SETTLEMENT_ROOT@ @PROOF_EXPORT@ @EXCHANGE_OUTBOX@ @MODEL_BYTE_STORE_ROOTS@
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
