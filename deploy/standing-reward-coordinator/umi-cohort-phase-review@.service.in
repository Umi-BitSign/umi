[Unit]
Description=UMI private native cohort phase reviewer (%i)
Wants=network-online.target umi-cohort-cpu-namespace@%i.service
After=network-online.target umi-cohort-cpu-namespace@%i.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=@SERVICE_USER@
Group=@SERVICE_GROUP@
UMask=0077
ExecStart=@PYTHON@ -I -B -m umi.competition_cohort_review_cli run --config @CONFIG_DIRECTORY@/%i.json
Restart=on-failure
RestartSec=15
TimeoutStopSec=infinity
KillSignal=SIGTERM
# Signal the owner first so it can finish its current proof and drain children.
KillMode=mixed
SendSIGKILL=no
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
# Expand to explicit account-private shared byte roots; empty for older omitted selections.
# Preserved import roots remain read-only under ProtectSystem=strict.
ReadWritePaths=@SIGNING_ROOT@ @CHAIN_STATE@ @PROMOTION_ROOT@ @INPUTS_ROOT@ @PROOF_IMPORT@ @MODEL_BYTE_STORE_ROOTS@
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
