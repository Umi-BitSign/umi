[Unit]
Description=UMI standing reward coordinator or independent reviewer (%i)
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=@SERVICE_USER@
Group=@SERVICE_GROUP@
UMask=0077
ExecStart=@PYTHON@ -I -B -m umi.competition_reward_coordinator_cli run --config @CONFIG_DIRECTORY@/%i.json
Restart=on-failure
RestartSec=15
# The owner drains signing, persistence and finality children on SIGTERM.
TimeoutStopSec=infinity
KillSignal=SIGTERM
KillMode=mixed
SendSIGKILL=no
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@STATE_ROOT@ @CHAIN_STATE@ @FILES_ROOT@ @PROMOTION_ROOT@ @PROOF_IMPORT@ @PROOF_EXPORT@ @EXCHANGE_INBOX@ @EXCHANGE_OUTBOX@
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
