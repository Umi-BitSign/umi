[Unit]
Description=Install verified UMI public-pilot evidence into the observer feed
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=umi-observer
Group=umi-observer
SupplementaryGroups=umi-pilot
UMask=0077
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/umi/umi-public-pilot-spool.env
ExecStart=/opt/umi-public-pilot/.venv/bin/umi-public-pilot-spool --incoming-dir /var/spool/umi-public-pilot/incoming --processing-dir /var/lib/umi-public-pilot-spool/processing --processed-dir /var/lib/umi-public-pilot-spool/processed --quarantine-dir /var/lib/umi-public-pilot-spool/quarantine --receipts-dir /var/lib/umi-public-pilot-spool/receipts --work-root /var/lib/umi-public-pilot-spool/work --publication-root /var/lib/umi-observer/pilots --config /var/lib/umi-observer/pilot-feed/observer-pilot-feed.json --lock /var/lib/umi-public-pilot-spool/publication.lock --spool-lock /var/lib/umi-public-pilot-spool/consumer.lock --public-origin https://api.umi.vision --expected-coordinator-hotkey ${UMI_PILOT_COORDINATOR_HOTKEY} --producer-uid ${UMI_PILOT_PRODUCER_UID} --producer-gid ${UMI_PILOT_PRODUCER_GID}
ExecStartPost=+/usr/bin/systemctl try-restart umi-observer.service
TimeoutStartSec=10min
TasksMax=128
LimitNOFILE=4096
LimitCORE=0
MemoryHigh=1073741824
MemoryMax=1610612736
OOMPolicy=stop

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
ReadOnlyPaths=/etc/umi /opt/umi-public-pilot
ReadWritePaths=/var/spool/umi-public-pilot/incoming /var/lib/umi-public-pilot-spool /var/lib/umi-observer/pilots /var/lib/umi-observer/pilot-feed
InaccessiblePaths=/home/sam/umi-coordinator/private /var/lib/umi-public-pilot-controller

[Install]
WantedBy=multi-user.target
