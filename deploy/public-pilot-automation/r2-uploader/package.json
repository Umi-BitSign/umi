{
  "name": "umi-public-pilot-r2-uploader",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "types": "wrangler types --env-file .dev.vars.example --strict-vars=false",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.config.json",
    "test": "vitest run",
    "deploy:dry-run": "wrangler deploy --dry-run --outdir dist",
    "check:startup": "wrangler check startup",
    "check": "npm run types && npm run typecheck && npm test && npm run deploy:dry-run && npm run check:startup"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.1.5",
    "@types/node": "24.10.1",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "wrangler": "4.129.1"
  }
}
