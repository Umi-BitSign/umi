# Copy this file outside the repository, set every value, and chmod it 0600.
# It contains paths and public identities, but never a seed, key, password, or
# mirror bearer. Mirror credentials belong in their own mode-0600 file under
# UMI_OPERATOR_INPUT_ROOT and are only referenced by local-bindings.json.
UMI_GIT_REVISION=REPLACE_WITH_40_CHARACTER_RELEASE_REVISION
UMI_VALIDATOR_IMAGE=umi-validator:REPLACE_WITH_40_CHARACTER_RELEASE_REVISION
# Unique lowercase token for this signed release, for example git12-manifest12.
UMI_DEPLOYMENT_ID=replace-with-git12-manifest12
UMI_VALIDATOR_PLATFORM=linux/amd64
UMI_VALIDATOR_MEMORY_LIMIT=12g
UMI_VALIDATOR_CPUS=8.0
UMI_AUDIT_ORIGIN_PORT=8093
UMI_RELEASE_ROOT=/absolute/path/to/signed-public-release
UMI_OPERATOR_INPUT_ROOT=/absolute/path/to/private-validator-inputs
UMI_WALLET_ROOT=/absolute/path/to/bittensor-wallets
UMI_AUDIT_PUBLISHER_INPUT_ROOT=/absolute/path/to/private-audit-publisher-inputs
UMI_EXPECTED_AUTHORITY_HOTKEY=REPLACE_WITH_RELEASE_AUTHORITY_HOTKEY
UMI_VALIDATOR_HOTKEY=REPLACE_WITH_VALIDATOR_HOTKEY
UMI_VALIDATOR_ACCOUNT_HEX=REPLACE_WITH_64_CHARACTER_VALIDATOR_ACCOUNT_HEX
