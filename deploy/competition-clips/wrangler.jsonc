{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "umi-competition-clips",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-16",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "logpush": false,
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false },
    "traces": { "enabled": false }
  },
  "r2_buckets": [{ "binding": "CLIPS", "bucket_name": "umi-competition-clips" }]
}
