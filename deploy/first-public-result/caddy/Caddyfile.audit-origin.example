{
	admin off
	auto_https off
}

# TLS terminates at Cloudflare. This listener is reachable only through the
# local cloudflared process.
http://:8093 {
	bind 127.0.0.1
	root * /srv/www/umi-audits

	log {
		output stdout
		format json
	}

	@non_read not method GET HEAD
	@index path_regexp index "^/validators/[0-9a-f]{64}/index[.]json$"
	@manifest path_regexp manifest "^/validators/[0-9a-f]{64}/windows/[0-9a-f]{64}/(calibration_no_weight|failed|skipped|void)/manifest[.]json$"
	@object path_regexp object "^/validators/[0-9a-f]{64}/windows/[0-9a-f]{64}/(calibration_no_weight|failed|skipped|void)/objects/[0-9a-f]{64}$"

	route {
		header {
			Content-Encoding identity
			Cross-Origin-Resource-Policy cross-origin
			Referrer-Policy no-referrer
			X-Content-Type-Options nosniff
			-Server
		}

		header @non_read Allow "GET, HEAD"
		respond @non_read 405

		handle @index {
			header {
				Cache-Control "no-cache, no-store, must-revalidate, no-transform"
				Content-Type application/json
			}
			file_server {
				disable_canonical_uris
				hide .git .DS_Store
			}
		}

		handle @manifest {
			header {
				Cache-Control "public, max-age=31536000, immutable, no-transform"
				Content-Type application/json
			}
			file_server {
				disable_canonical_uris
				hide .git .DS_Store
			}
		}

		handle @object {
			header {
				Cache-Control "public, max-age=31536000, immutable, no-transform"
				Content-Type application/octet-stream
			}
			file_server {
				disable_canonical_uris
				hide .git .DS_Store
			}
		}

		respond 404
	}
}
