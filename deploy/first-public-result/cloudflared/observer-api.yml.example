# Replace both placeholders with the UUID created for the observer host.
# The credentials JSON is secret local state; never commit it.
tunnel: REPLACE_WITH_OBSERVER_TUNNEL_UUID
credentials-file: /etc/cloudflared/REPLACE_WITH_OBSERVER_TUNNEL_UUID.json

ingress:
  - hostname: api.umi.vision
    service: http://127.0.0.1:8092
    originRequest:
      connectTimeout: 10s
  - service: http_status:404
