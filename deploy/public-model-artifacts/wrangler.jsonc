{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "umi-public-model-artifacts",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "artifacts.umi.vision",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    },
    "traces": {
      "enabled": false
    }
  },
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "umi-model-artifacts"
    }
  ]
}
