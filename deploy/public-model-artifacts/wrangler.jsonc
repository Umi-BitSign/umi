{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "umi-public-model-artifacts",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "METADATA_ENDPOINT": "https://91287420c3cb985d6d726f4ddd730b18.r2.cloudflarestorage.com",
    "METADATA_BUCKET": "umi-model-artifacts",
    "PROOF_ENDPOINT": "https://91287420c3cb985d6d726f4ddd730b18.r2.cloudflarestorage.com",
    "PROOF_BUCKET": "umi-cohort-evidence"
  },
  "routes": [
    {
      "pattern": "artifacts.umi.vision",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    },
    "traces": {
      "enabled": false
    }
  },
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "umi-model-artifacts"
    },
    {
      "binding": "PROOF_EVIDENCE",
      "bucket_name": "umi-cohort-evidence"
    }
  ]
}
